@page "/ratings"
@using DirtyOlives.Core.Models
@using DirtyOlives.Core.Services
@using DirtyOlives.Client.Components
@using DirtyOlives.Client.Services
@inject RatingsStorageService Storage

<PageTitle>Martini Ratings</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Dirty Martini Ratings</h1>
    <button class="btn btn-primary" @onclick="OpenDialog">Add Rating</button>
</div>

<div class="user-bar mb-3">
    <label class="form-label mb-0" for="userId">User Id</label>
    <input id="userId" type="number" min="1" class="form-control user-id-input" value="@userId"
           @onchange="OnUserIdChanged" />
    <button class="btn btn-outline-secondary" @onclick="LoadRatings">Load Ratings</button>
    <span class="text-muted small">Ratings are stored per user id.</span>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!isLoaded)
{
    <p><em>Loading your ratings…</em></p>
}
else if (Ratings.Count == 0)
{
    <p class="text-muted">No martinis rated yet for user @userId. Add your first one to get started.</p>
}
else
{
    <div class="row g-3">
        @foreach (var rating in Ratings.OrderByDescending(r => r.DateRated))
        {
            var recommendation = SidePieceRecommendationEngine.Recommend(rating);

            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title mb-1">@(string.IsNullOrWhiteSpace(rating.Location) ? "Unknown bar" : rating.Location)</h5>
                                <h6 class="card-subtitle text-muted">@rating.DateRated.ToString("d")</h6>
                            </div>
                            <div class="text-end">
                                <div class="final-score">@OliveScale(rating.FinalRating)</div>
                                <small class="text-muted d-block">
                                    @rating.FinalRating.ToString("0.#") / 10 olives
                                    @(rating.IsManuallyRated ? " (manual)" : string.Empty)
                                </small>
                                <small class="text-muted d-block">Side piece score: @rating.CalculatedRating.ToString("0.#") / 10</small>
                            </div>
                        </div>

                        <hr />

                        <dl class="row mb-0 small">
                            <dt class="col-5">Glass</dt>
                            <dd class="col-7">@rating.GlassStyleDisplay — @Symbols("★", rating.GlassRating)</dd>

                            <dt class="col-5">Olives</dt>
                            <dd class="col-7">
                                @rating.OliveCount@(string.IsNullOrWhiteSpace(rating.OliveType) ? "" : $" × {rating.OliveType}") — @OliveSymbols(rating.OlivesRating)
                            </dd>

                            <dt class="col-5">Mixture</dt>
                            <dd class="col-7">@Symbols("★", rating.MixtureRating)</dd>

                            <dt class="col-5">Vodka</dt>
                            <dd class="col-7">
                                @(string.IsNullOrWhiteSpace(rating.Vodka) ? "Unspecified" : rating.Vodka) — @Symbols("★", rating.VodkaRating)
                            </dd>

                            <dt class="col-5">Ice Crispys</dt>
                            <dd class="col-7">@(rating.HasIceCrispys ? "Yes ❄️" : "No")</dd>
                        </dl>

                        <div class="side-piece mt-3">
                            <strong>Side Piece Recommendation:</strong> @recommendation.Name
                            <div class="small text-muted">@recommendation.Reason</div>
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(rating)">Delete</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (IsDialogOpen)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Add Martini Rating</h4>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Glass Style</label>
                        <div class="glass-style-picker">
                            @foreach (var style in Enum.GetValues<GlassStyle>())
                            {
                                var current = style;
                                <button type="button"
                                        class="glass-option @(NewRating.GlassStyle == current ? "selected" : "")"
                                        @onclick="() => NewRating.GlassStyle = current">
                                    <span class="glass-icon">@GlassIcon(current)</span>
                                    <span class="glass-name">@GlassName(current)</span>
                                </button>
                            }
                        </div>
                        <div class="mt-2">
                            <label class="form-label mb-0">Glass Rating</label>
                            <StarRating @bind-Value="NewRating.GlassRating" Glyph="★" Label="Glass rating" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Olives</label>
                        <div class="row g-2">
                            <div class="col-sm-4">
                                <label class="form-label small mb-0">Count</label>
                                <InputNumber class="form-control" @bind-Value="NewRating.OliveCount" min="0" />
                            </div>
                            <div class="col-sm-8">
                                <label class="form-label small mb-0">Type</label>
                                <select class="form-select" value="@selectedOliveType" @onchange="OnOliveTypeChanged">
                                    <option value="">Select an olive…</option>
                                    @foreach (var option in OliveTypes.All)
                                    {
                                        <option value="@option.Name" title="@option.Description">@option.Name</option>
                                    }
                                    <option value="@OliveTypes.Other">Other…</option>
                                </select>

                                @if (isOtherOliveType)
                                {
                                    <InputText class="form-control mt-2" @bind-Value="NewRating.OliveType"
                                               placeholder="Type the olive variety…" />
                                }
                                else if (OliveTypes.DescriptionFor(selectedOliveType) is { } oliveDescription)
                                {
                                    <div class="form-text">@oliveDescription</div>
                                }
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="form-label mb-0">Olive Rating</label>
                            <StarRating @bind-Value="NewRating.OlivesRating" UseOliveIcon="true" Label="Olive rating" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Vodka</label>
                        <select class="form-select" value="@selectedVodka" @onchange="OnVodkaChanged">
                            <option value="">Select a vodka…</option>
                            @foreach (var vodka in VodkaTypes.All)
                            {
                                <option value="@vodka">@vodka</option>
                            }
                            <option value="@VodkaTypes.Other">Other…</option>
                        </select>

                        @if (isOtherVodka)
                        {
                            <InputText class="form-control mt-2" @bind-Value="NewRating.Vodka"
                                       placeholder="Type the vodka…" />
                        }
                        <div class="mt-2">
                            <label class="form-label mb-0">Vodka Rating</label>
                            <StarRating @bind-Value="NewRating.VodkaRating" Glyph="★" Label="Vodka rating" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mixture Rating</label>
                        <StarRating @bind-Value="NewRating.MixtureRating" Glyph="★" Label="Mixture rating" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox class="form-check-input" id="iceCrispys" @bind-Value="NewRating.HasIceCrispys" />
                        <label class="form-check-label" for="iceCrispys">Has ice crispys ❄️</label>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-8">
                            <label class="form-label">Location</label>
                            <InputText class="form-control" @bind-Value="NewRating.Location" placeholder="Where did you drink it?" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label">Date</label>
                            <InputDate class="form-control" @bind-Value="NewRating.DateRated" />
                        </div>
                    </div>

                    <div class="alert alert-secondary mb-0">
                        <div class="final-score justify-content-start">@OliveScale(NewRating.CalculatedRating)</div>
                        <div>
                            <strong>Side piece score: @NewRating.CalculatedRating.ToString("0.#") / 10 olives</strong>
                        </div>
                        <div class="small text-muted">
                            Total: @NewRating.FinalRating.ToString("0.#") / 10 @(NewRating.IsManuallyRated ? "(manual)" : "(calculated)")
                        </div>
                        <div class="mt-2">
                            <label class="form-label mb-0">Overall Rating (half olives allowed)</label>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <OliveScore Value="@(NewRating.ManualFinalRating ?? 0)"
                                            ValueChanged="OnManualRatingChanged"
                                            Max="10"
                                            Label="Overall rating" />
                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="UseCalculatedScore">Use side piece score</button>
                            </div>
                        </div>
                        <div class="small mt-2">
                            Side Piece Recommendation: @SidePieceRecommendationEngine.Recommend(NewRating).Name
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-success" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MartiniRating> Ratings = new();
    private MartiniRating NewRating = new();
    private bool IsDialogOpen;
    private bool isLoaded;
    private int userId = MartiniRating.DefaultUserId;
    private string? errorMessage;
    private string selectedOliveType = string.Empty;
    private bool isOtherOliveType;
    private string selectedVodka = string.Empty;
    private bool isOtherVodka;

    protected override Task OnInitializedAsync() => LoadRatings();

    private async Task OnUserIdChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var parsed) && parsed > 0)
        {
            userId = parsed;
            await LoadRatings();
        }
    }

    private async Task LoadRatings()
    {
        isLoaded = false;
        errorMessage = null;

        try
        {
            Ratings = await Storage.LoadAsync(userId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load ratings: {ex.Message}";
            Ratings = new List<MartiniRating>();
        }
        finally
        {
            isLoaded = true;
        }
    }

    private void OpenDialog()
    {
        NewRating = new MartiniRating { UserId = userId };
        SyncOliveTypeSelection(NewRating.OliveType);
        SyncVodkaSelection(NewRating.Vodka);
        IsDialogOpen = true;
    }

    /// <summary>Handles the olive variety dropdown, revealing a text box for "Other".</summary>
    private void OnOliveTypeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;

        if (value == OliveTypes.Other)
        {
            selectedOliveType = OliveTypes.Other;
            isOtherOliveType = true;
            NewRating.OliveType = string.Empty;
            return;
        }

        selectedOliveType = value;
        isOtherOliveType = false;
        NewRating.OliveType = value;
    }

    /// <summary>Points the dropdown at an existing value, falling back to "Other".</summary>
    private void SyncOliveTypeSelection(string? oliveType)
    {
        if (string.IsNullOrWhiteSpace(oliveType))
        {
            selectedOliveType = string.Empty;
            isOtherOliveType = false;
        }
        else if (OliveTypes.IsKnown(oliveType))
        {
            selectedOliveType = oliveType;
            isOtherOliveType = false;
        }
        else
        {
            selectedOliveType = OliveTypes.Other;
            isOtherOliveType = true;
        }
    }

    /// <summary>Handles the vodka dropdown, revealing a text box for "Other".</summary>
    private void OnVodkaChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;

        if (value == VodkaTypes.Other)
        {
            selectedVodka = VodkaTypes.Other;
            isOtherVodka = true;
            NewRating.Vodka = string.Empty;
            return;
        }

        selectedVodka = value;
        isOtherVodka = false;
        NewRating.Vodka = value;
    }

    /// <summary>Points the dropdown at an existing value, falling back to "Other".</summary>
    private void SyncVodkaSelection(string? vodka)
    {
        if (string.IsNullOrWhiteSpace(vodka))
        {
            selectedVodka = string.Empty;
            isOtherVodka = false;
        }
        else if (VodkaTypes.IsKnown(vodka))
        {
            selectedVodka = vodka;
            isOtherVodka = false;
        }
        else
        {
            selectedVodka = VodkaTypes.Other;
            isOtherVodka = true;
        }
    }

    private void CloseDialog() => IsDialogOpen = false;

    private async Task Save()
    {
        errorMessage = null;
        NewRating.UserId = userId;

        try
        {
            var saved = await Storage.AddAsync(NewRating);
            Ratings.Add(saved);
            IsDialogOpen = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not save rating: {ex.Message}";
        }
    }

    private async Task Delete(MartiniRating rating)
    {
        errorMessage = null;

        try
        {
            await Storage.DeleteAsync(rating.Id, rating.UserId);
            Ratings.Remove(rating);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete rating: {ex.Message}";
        }
    }

    private void OnManualRatingChanged(double value)
    {
        // Clicking the current olive clears the manual score and falls back to the calculated one.
        NewRating.ManualFinalRating = value <= 0 ? null : value;
    }

    /// <summary>Copies the calculated side piece score into the manual total.</summary>
    private void UseCalculatedScore() => NewRating.ManualFinalRating = NewRating.CalculatedRating;

    private static string Symbols(string glyph, int count) =>
        count <= 0 ? "unrated" : string.Concat(Enumerable.Repeat(glyph, count));

    /// <summary>Renders a 1-5 category score as olive icons.</summary>
    private static RenderFragment OliveSymbols(int count) => builder =>
    {
        if (count <= 0)
        {
            builder.AddContent(0, "unrated");
            return;
        }

        for (var i = 0; i < count; i++)
        {
            // Sequence numbers must be constant literals, not loop variables.
            builder.OpenComponent<OliveIcon>(1);
            builder.CloseComponent();
        }
    };

    /// <summary>Renders the 0-10 score as whole olives followed by an optional half.</summary>
    private static RenderFragment OliveScale(double score) => builder =>
    {
        var whole = (int)Math.Floor(score);
        var hasHalf = score - whole >= 0.5;

        for (var i = 0; i < whole; i++)
        {
            builder.OpenComponent<OliveIcon>(0);
            builder.CloseComponent();
        }

        // Distinct sequence number so the diff never confuses the trailing half
        // olive with a whole one and leaves Half=true on the wrong icon.
        if (hasHalf)
        {
            builder.OpenComponent<OliveIcon>(1);
            builder.AddComponentParameter(2, nameof(OliveIcon.Half), true);
            builder.CloseComponent();
        }
    };

    private static string GlassIcon(GlassStyle style) => style switch
    {
        GlassStyle.Classic => "🍸",
        GlassStyle.Coupe => "🥂",
        GlassStyle.NickAndNora => "🍷",
        GlassStyle.Stemless => "🥃",
        GlassStyle.Rocks => "🥛",
        _ => "🍹"
    };

    private static string GlassName(GlassStyle style) => style switch
    {
        GlassStyle.NickAndNora => "Nick & Nora",
        _ => style.ToString()
    };
}
