@using DirtyOlives.Core.Models
@using DirtyOlives.Client.Services
@inject DatabaseHealthService Health
@implements IDisposable

@if (status is not null && isVisible)
{
    <div class="db-toast @(status.IsHealthy ? "db-toast-success" : "db-toast-error")" role="status" aria-live="polite">
        <div class="db-toast-body">
            <strong class="db-toast-title">@status.Message</strong>

            @if (!status.IsHealthy)
            {
                <div class="db-toast-detail">
                    @if (!string.IsNullOrWhiteSpace(status.Error))
                    {
                        <div class="db-toast-error-text">@status.Error</div>
                    }
                    <div class="db-toast-meta">@status.DataSource</div>
                </div>
            }
        </div>

        <button type="button" class="db-toast-close" aria-label="Dismiss" @onclick="Dismiss">&times;</button>
    </div>
}

@code {
    private DatabaseStatus? status;
    private bool isVisible;
    private CancellationTokenSource? autoHideCts;

    /// <summary>Success toasts disappear on their own; failures stay until dismissed.</summary>
    private const int SuccessToastMs = 4000;
    private bool startupChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Also runs during static prerendering, where the toast cannot be shown.
        if (startupChecked || !RendererInfo.IsInteractive)
        {
            return;
        }

        startupChecked = true;

        await ShowAsync(await Health.GetStartupStatusAsync());
    }

    /// <summary>Runs the insert/read/delete round trip and reports the result.</summary>
    public async Task RunWriteTestAsync()
    {
        await ShowAsync(new DatabaseStatus { IsHealthy = true, Message = "Testing database…" }, autoHide: false);
        await ShowAsync(await Health.RunWriteTestAsync());
    }

    private async Task ShowAsync(DatabaseStatus newStatus, bool autoHide = true)
    {
        autoHideCts?.Cancel();
        autoHideCts?.Dispose();
        autoHideCts = null;

        status = newStatus;
        isVisible = true;
        StateHasChanged();

        if (!autoHide || !newStatus.IsHealthy)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        autoHideCts = cts;

        try
        {
            await Task.Delay(SuccessToastMs, cts.Token);
            isVisible = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer toast.
        }
    }

    private void Dismiss()
    {
        autoHideCts?.Cancel();
        isVisible = false;
    }

    public void Dispose()
    {
        autoHideCts?.Cancel();
        autoHideCts?.Dispose();
    }
}
