@implements IAsyncDisposable
@inject IJSRuntime JS

@* Ambient decoration: an olive that falls down the page, bouncing off headings,
   cards, and paragraphs before rolling off the bottom. Physics live in JS
   because bouncing needs real element positions, which CSS cannot read. *@

<div @ref="oliveElement" class="rolling-olive" aria-hidden="true">
	<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
		<ellipse cx="12" cy="12" rx="9" ry="11" fill="#7a9a2b" />
		<path d="M12 1a9 11 0 0 1 0 22 9 11 0 0 0 0-22z" fill="#5d7a1e" opacity="0.55" />
		<ellipse cx="8.4" cy="7.6" rx="2" ry="3.2" fill="#c3dc72" opacity="0.7" transform="rotate(-20 8.4 7.6)" />
		<ellipse cx="12" cy="12" rx="3.1" ry="4.3" fill="#c0392b" />
		<ellipse cx="11.2" cy="10.6" rx="0.9" ry="1.3" fill="#e8705f" opacity="0.8" />
	</svg>
</div>

@code {
	private ElementReference oliveElement;
	private bool started;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// This component lives in the layout, which is statically prerendered on
		// the server. Interop is only legal once the render mode is interactive.
		if (started || !RendererInfo.IsInteractive)
		{
			return;
		}

		started = true;

		try
		{
			await JS.InvokeVoidAsync("startRollingOlive", oliveElement);
		}
		catch (JSException)
		{
			// Decoration only.
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (!started)
		{
			return;
		}

		try
		{
			await JS.InvokeVoidAsync("stopRollingOlive");
		}
		catch (JSException)
		{
		}
		catch (JSDisconnectedException)
		{
		}
		catch (InvalidOperationException)
		{
		}
	}
}
