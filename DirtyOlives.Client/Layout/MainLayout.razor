@inherits LayoutComponentBase
@using DirtyOlives.Client.Components

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="TestDatabaseAsync">
                Test DB
            </button>
            <div class="ms-auto">
                <DropOliveButton />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<DatabaseStatusToast @ref="dbToast" />

@code {
    private DatabaseStatusToast? dbToast;

    private async Task TestDatabaseAsync()
    {
        if (dbToast is not null)
        {
            await dbToast.RunWriteTestAsync();
        }
    }
}

